# AtlasVibe Environment Configuration Example
# Copy this file to .env and fill in the appropriate values

# === Core Application Settings ===
# Python environment settings
PYTHONPATH=.

# Application mode (development, production, test)
NODE_ENV=development

# === Backend Server Settings ===
# FastAPI server configuration
BACKEND_PORT=5392
BACKEND_HOST=0.0.0.0
LOG_LEVEL=INFO

# === Docker/Container Settings ===
# Disable components for containerized environments
DISABLE_FILE_WATCHER=false
DISABLE_CHANGE_QUEUE=false

# === Testing Settings ===
# Test environment detection
PYTEST_CURRENT_TEST=
CI=
GITHUB_ACTIONS=

# === API Keys (Optional) ===
# Add your API keys here for various services
# OPENROUTER_API_KEY=your_key_here
# OPENAI_API_KEY=your_key_here

# === Virtual Environment Settings ===
# UV Python management
UV_PYTHON_INSTALL_DIR=
UV_CACHE_DIR=
UV_NO_CACHE=
UV_PYTHON=
UV_MANAGED_PYTHON=
UV_NO_MANAGED_PYTHON=
UV_PYTHON_DOWNLOADS=

# === Development Tools ===
# Code formatting and linting
COLUMNS=400  # For mypy output formatting

# === Platform-specific Settings ===
# Display settings for headless environments
DISPLAY=:0  # For X11 forwarding

# === Project-specific Settings ===
# Add any project-specific environment variables below
