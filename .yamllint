# yamllint configuration for AtlasVibe
extends: default

rules:
  # Allow longer lines for readability
  line-length:
    max: 320
    level: warning

  # Don't require document start marker
  document-start: disable

  # Allow both single and double quotes
  quoted-strings:
    quote-type: any
    required: false

  # Truthy values configuration
  truthy:
    allowed-values: ['true', 'false', 'yes', 'no', 'on', 'off']

  # Comments formatting
  comments:
    min-spaces-from-content: 1

  # Brackets and braces
  brackets:
    min-spaces-inside: 0
    max-spaces-inside: 1

  braces:
    min-spaces-inside: 0
    max-spaces-inside: 1

  # Indentation - Allow GitHub Actions style
  indentation:
    spaces: 2
    indent-sequences: false  # GitHub Actions uses unindented sequences

  # Empty lines
  empty-lines:
    max: 2
    max-start: 0
    max-end: 1

# Ignore certain paths
ignore: |
  .venv/
  venv/
  node_modules/
  dist/
  out/
  build/
  *.egg-info/
  .git/
