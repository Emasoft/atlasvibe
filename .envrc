# AtlasVibe development environment configuration
# This file is used by direnv to automatically set up the development environment

# Git configuration
export GIT_AUTHOR_NAME="Emasoft"
export GIT_AUTHOR_EMAIL="713559+Emasoft@users.noreply.github.com"
export GIT_COMMITTER_NAME="Emasoft"
export GIT_COMMITTER_EMAIL="713559+Emasoft@users.noreply.github.com"

# Python environment - use uv
if [[ -f ".venv/bin/activate" ]]; then
    echo "Activating Python virtual environment managed by uv..."
    source .venv/bin/activate
else
    echo "No virtual environment found. Run 'uv venv' to create one."
fi

# Set Python to use uv's virtual environment
if command -v uv &> /dev/null; then
    export UV_PYTHON="$(pwd)/.venv/bin/python"
fi

# Development tools
export EDITOR="code --wait"

# Disable telemetry
export DISABLE_TELEMETRY=YES

# MCP timeout for long-running operations
export MCP_TOOL_TIMEOUT=1800000

echo "AtlasVibe development environment loaded"
echo "Git user: $GIT_AUTHOR_NAME <$GIT_AUTHOR_EMAIL>"
echo "Virtual env: ${VIRTUAL_ENV:-Not activated}"